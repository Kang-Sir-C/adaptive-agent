{
  "name": "adaptive-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Adaptive multi-model orchestration kernel for Node/TypeScript. Triage, workflow selection, tiered routing, evaluation, and trace persistence.",
  "keywords": [
    "llm",
    "routing",
    "orchestration",
    "multi-model",
    "openai",
    "typescript",
    "agent"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/app/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/app/server.js",
    "check": "tsc -p tsconfig.json --noEmit",
    "exp:samples": "tsx src/experiments/run-samples.ts",
    "exp:analyze": "tsx src/experiments/analyze-traces.ts",
    "smoke": "tsx src/experiments/smoke.ts",
    "smoke:openai": "tsx src/experiments/smoke-openai.ts",
    "watch": "tsx src/experiments/watch-traces.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/node": "^22.13.14",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
